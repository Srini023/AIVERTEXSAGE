8. Rollback Validation Script
verify_rollback.sh

#!/bin/bash

set -e

ENDPOINT_NAME="$1"
EXPECTED_CONFIG=$(cat previous_config.txt)

echo "Verifying rollback..."

CURRENT_CONFIG=$(aws sagemaker describe-endpoint \
    --endpoint-name "$ENDPOINT_NAME" \
    --query EndpointConfigName \
    --output text)

STATUS=$(aws sagemaker describe-endpoint \
    --endpoint-name "$ENDPOINT_NAME" \
    --query EndpointStatus \
    --output text)

if [ "$CURRENT_CONFIG" != "$EXPECTED_CONFIG" ]; then
    echo "FAIL: Incorrect endpoint config"
    exit 1
fi

if [ "$STATUS" != "InService" ]; then
    echo "FAIL: Endpoint not InService"
    exit 1
fi

aws sagemaker-runtime invoke-endpoint \
    --endpoint-name "$ENDPOINT_NAME" \
    --content-type application/json \
    --body fileb://golden_request.json \
    /tmp/response.json >/dev/null

if [ ! -s /tmp/response.json ]; then
    echo "FAIL: Prediction test failed"
    exit 1
fi

echo "PASS: Rollback verified"


CI/CD Rollback Stage
Jenkins

post {
    failure {
        sh '''
            ./rollback_endpoint.sh \
              my-endpoint \
              $(cat previous_config.txt)

            ./verify_rollback.sh \
              my-endpoint
        '''
    }
}


GitHub Actions
- name: Rollback
  if: failure()
  run: |
    ./rollback_endpoint.sh my-endpoint \
      $(cat previous_config.txt)

- name: Verify Rollback
  if: failure()
  run: |
    ./verify_rollback.sh my-endpoint



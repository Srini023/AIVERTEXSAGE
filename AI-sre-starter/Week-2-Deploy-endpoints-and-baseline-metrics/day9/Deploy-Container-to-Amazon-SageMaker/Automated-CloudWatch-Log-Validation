CloudWatch Health Check Script
cloudwatch_log_check.sh
#!/bin/bash

ENDPOINT_NAME="my-endpoint"
LOG_GROUP="/aws/sagemaker/Endpoints/${ENDPOINT_NAME}"

START_TIME=$((($(date +%s)-3600)*1000))

echo "Checking logs from last 60 minutes..."
echo "Log Group: $LOG_GROUP"
echo ""

aws logs filter-log-events \
    --log-group-name "$LOG_GROUP" \
    --start-time "$START_TIME" \
    --query 'events[*].message' \
    --output text > endpoint_logs.txt

ERROR_COUNT=$(grep -Ei \
'error|exception|traceback|failed|failure|timeout|modelerror|internalservererror|oom|outofmemory|killed' \
endpoint_logs.txt | wc -l)

echo "Error Count: $ERROR_COUNT"

if [ "$ERROR_COUNT" -eq 0 ]; then
    echo "PASS: No critical errors detected."
else
    echo "FAIL: Errors detected."
    echo ""
    grep -Ein \
    'error|exception|traceback|failed|failure|timeout|modelerror|internalservererror|oom|outofmemory|killed' \
    endpoint_logs.txt
fi

Run:
chmod +x cloudwatch_log_check.sh
./cloudwatch_log_check.sh

Endpoint Health Validation Script
endpoint_health_check.sh

#!/bin/bash

ENDPOINT_NAME="my-endpoint"

STATUS=$(aws sagemaker describe-endpoint \
  --endpoint-name "$ENDPOINT_NAME" \
  --query EndpointStatus \
  --output text)

echo "Endpoint Status: $STATUS"

if [ "$STATUS" != "InService" ]; then
    echo "FAIL: Endpoint unhealthy."
    exit 1
fi

echo "PASS: Endpoint healthy."

Generate Automated SRE Health Report
sre_validation.sh

#!/bin/bash

ENDPOINT_NAME="my-endpoint"

echo "=================================="
echo "SageMaker Validation Report"
echo "=================================="

STATUS=$(aws sagemaker describe-endpoint \
    --endpoint-name "$ENDPOINT_NAME" \
    --query EndpointStatus \
    --output text)

echo "Endpoint Status : $STATUS"

if [ "$STATUS" != "InService" ]; then
    echo "Overall Status  : FAIL"
    exit 1
fi

LOG_GROUP="/aws/sagemaker/Endpoints/${ENDPOINT_NAME}"

START_TIME=$((($(date +%s)-3600)*1000))

ERRORS=$(aws logs filter-log-events \
    --log-group-name "$LOG_GROUP" \
    --start-time "$START_TIME" \
    --query 'events[*].message' \
    --output text | \
    grep -Ei \
    'error|exception|traceback|failed|failure|timeout|modelerror|internalservererror' \
    | wc -l)

echo "Error Count     : $ERRORS"

if [ "$ERRORS" -gt 0 ]; then
    echo "Overall Status  : FAIL"
    exit 1
fi

echo "Overall Status  : PASS"



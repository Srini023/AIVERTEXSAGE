Step 5: Automated Latency Validation
latency_test.sh

#!/bin/bash

ENDPOINT_NAME="my-endpoint"
REQUEST_FILE="request.json"

RUNS=10

MIN=999999
MAX=0
TOTAL=0

for ((i=1;i<=RUNS;i++))
do
    START=$(date +%s%3N)

    aws sagemaker-runtime invoke-endpoint \
      --endpoint-name "$ENDPOINT_NAME" \
      --content-type application/json \
      --body fileb://"$REQUEST_FILE" \
      /tmp/response.json >/dev/null

    END=$(date +%s%3N)

    LATENCY=$((END-START))

    echo "Run $i : ${LATENCY} ms"

    TOTAL=$((TOTAL + LATENCY))

    if [ $LATENCY -lt $MIN ]; then
        MIN=$LATENCY
    fi

    if [ $LATENCY -gt $MAX ]; then
        MAX=$LATENCY
    fi
done

AVG=$((TOTAL / RUNS))

echo ""
echo "Min Latency : ${MIN} ms"
echo "Max Latency : ${MAX} ms"
echo "Avg Latency : ${AVG} ms"

Run:

Shell
chmod +x latency_test.sh
./latency_test.sh


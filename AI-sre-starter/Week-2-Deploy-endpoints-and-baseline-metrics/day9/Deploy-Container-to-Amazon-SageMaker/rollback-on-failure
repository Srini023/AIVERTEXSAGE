Jenkins Pipeline Example
pipeline {

    stages {

        stage('Deploy') {
            steps {
                sh './deploy.sh'
            }
        }

        stage('Validate') {
            steps {
                sh '''
                    ./validate_sagemaker_endpoint.sh my-endpoint
                '''
            }
        }
    }

    post {

        failure {

            sh '''
                ./rollback_endpoint.sh \
                  my-endpoint \
                  $(cat previous_config.txt)
            '''
        }

        success {
            echo 'Deployment validated successfully.'
        }
    }
}




GitHub Actions Example
- name: Validate Endpoint
  run: |

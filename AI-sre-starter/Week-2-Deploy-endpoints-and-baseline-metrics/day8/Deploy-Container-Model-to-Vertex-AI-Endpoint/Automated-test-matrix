#!/bin/bash

set -e

PROJECT_ID="<PROJECT_ID>"
ENDPOINT_ID="<ENDPOINT_ID>"
REGION="us-central1"

TOKEN=$(gcloud auth print-access-token)

ENDPOINT_URL="https://${REGION}-aiplatform.googleapis.com/v1/projects/${PROJECT_ID}/locations/${REGION}/endpoints/${ENDPOINT_ID}:predict"

REQUEST_FILE="request.json"

CONCURRENCY_LEVELS=(1 5 10 20 50 100)
REQUESTS_PER_TEST=500

OUTPUT_FILE="latency.csv"

echo "concurrency,avg_ms,p95_ms,rps" > $OUTPUT_FILE

for C in "${CONCURRENCY_LEVELS[@]}"
do
    echo "================================="
    echo "Testing concurrency $C"
    echo "================================="

    hey \
      -n $REQUESTS_PER_TEST \
      -c $C \
      -m POST \
      -H "Authorization: Bearer $TOKEN" \
      -H "Content-Type: application/json" \
      -D $REQUEST_FILE \
      "$ENDPOINT_URL" \
      > hey_output.txt

    AVG=$(grep "Average:" hey_output.txt | awk '{print $2}')
    P95=$(grep "95%" hey_output.txt | awk '{print $3}')
    RPS=$(grep "Requests/sec:" hey_output.txt | awk '{print $2}')

    AVG_MS=$(echo "$AVG * 1000" | bc | awk '{printf "%.0f",$1}')
    P95_MS=$(echo "$P95 * 1000" | bc | awk '{printf "%.0f",$1}')

    echo "$C,$AVG_MS,$P95_MS,$RPS" >> $OUTPUT_FILE
done

echo ""
echo "Benchmark complete."
echo "Results written to $OUTPUT_FILE"

cat $OUTPUT_FILE



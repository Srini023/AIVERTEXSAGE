#Upload Container as a Vertex AI Model

#Upload Container as a Vertex AI Model

gcloud ai models upload \
  --region=us-central1 \
  --display-name=my-model \
  --container-image-uri=us-central1-docker.pkg.dev/PROJECT_ID/REPO_NAME/model-image:latest

#For custom model artifacts stored in Cloud Storage, you can also specify:

gcloud ai models upload \
  --region=us-central1 \
  --display-name=my-model \
  --container-image-uri=us-central1-docker.pkg.dev/PROJECT_ID/REPO_NAME/model-image:latest \
  --artifact-uri=gs://BUCKET_NAME/model-artifacts/


#The gcloud ai models upload command registers a new model in Vertex AI using the specified serving container image.

#2. Create a Vertex AI Endpoint

gcloud ai endpoints create \
  --region=us-central1 \
  --display-name=my-endpoint

#After creation, list endpoints:
gcloud ai endpoints list --region=us-central1

#3. Capture Model ID (SRE Note)

List models:
gcloud ai models list --region=us-central1

#4. Capture Endpoint ID (SRE Note)
gcloud ai endpoints list --region=us-central1

#5. (Optional but Recommended) Deploy Model to Endpoint
gcloud ai endpoints deploy-model ENDPOINT_ID \
  --region=us-central1 \
  --model=MODEL_ID \
  --display-name=my-deployment \
  --machine-type=n1-standard-2 \
  --traffic-split=0=100


